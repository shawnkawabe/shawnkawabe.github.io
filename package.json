{
  "name": "shawnkawabe-portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run tokens",
    "dev": "astro dev",
    "tokens": "node style-dictionary.config.js",
    "build": "npm run tokens && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && prettier --check . && node scripts/check-raw-colors.js",
    "test": "vitest run --coverage",
    "test:a11y": "playwright test",
    "grammar": "node scripts/grammar.mjs",
    "og": "node scripts/og.mjs",
    "validate:content": "astro sync",
    "check:links": "linkinator dist --recurse --concurrency 20 --retry-errors --retry-errors-count 3 --skip \"^(?!http://(localhost|127\\.0\\.0\\.1)[:/])\"",
    "ci": "npm run tokens && npm run lint && npm run validate:content && npm test && npm run build && npm run check:links",
    "prepare": "husky",
    "globe:land": "node scripts/globe-land.mjs",
    "globe:poster": "node scripts/globe-poster.mjs"
  },
  "lint-staged": {
    "*.{astro,ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "linkinator": "^8.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "style-dictionary": "^5.7.1",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  }
}
