---
// SPEC §5.5 (ADR 0008, L-26): a professional bio. The page header carries the first bio paragraph,
// the rest of the bio, the location and the actions (resume as the round primary action, then
// Contact); the photo shows only when approved and published. Then the principles as numbered
// rows and the companies as a ledger. No boxes and no dates anywhere.
import CompanyList from '@/components/patterns/CompanyList.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import RoundAction from '@/components/ui/RoundAction.astro';
import SectionRow from '@/components/ui/SectionRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { visibleImage } from '@/lib/case-study';
import { getExperience, getProjects, getSite, publicFileExists, siteLocales } from '@/lib/content';
import { localePath, strings, toLocale } from '@/lib/i18n';
import { pageMeta } from '@/lib/seo';

export function getStaticPaths() {
  return siteLocales().map((locale) => ({ params: { locale } }));
}

const locale = toLocale(Astro.params.locale);
const ui = strings(locale);

const site = getSite(locale);
const [experience, projects] = await Promise.all([getExperience(locale), getProjects(locale)]);
const photo = visibleImage(site.photo ?? undefined, publicFileExists);
const [lead, ...bio] = site.bio;
const t = ui.about;
---

<BaseLayout meta={pageMeta(site, { page: 'about' }, ui.titleTemplate)}>
  <div class="mx-auto flex w-full max-w-300 flex-col gap-12 px-4 py-16 sm:px-6 lg:gap-16 lg:px-8 lg:py-24">
    <div class:list={['grid items-start gap-10', photo && 'md:grid-cols-[1fr_2fr]']}>
      {photo && (
        <img
          src={photo.src}
          alt={photo.alt}
          class="aspect-square w-full max-w-80 rounded-lg object-cover"
        />
      )}
      <PageHeader title={site.seo.pages.about.title} lead={lead}>
        {bio.map((paragraph) => (
          <p class="text-3 text-on-surface-2">{paragraph}</p>
        ))}
        {site.location && <p class="font-mono text-2 text-on-surface-2">{site.location}</p>}
        <Fragment slot="actions">
          <RoundAction href={site.links.resume} label={t.resume} external />
          <a href={localePath(locale, '/contact')} class="text-3 font-medium underline">
            {ui.nav.contact}
          </a>
        </Fragment>
      </PageHeader>
    </div>

    {site.principles.length > 0 && (
      <SectionRow label={t.principles} id="principles-title">
        <ol class="border-t border-border-1">
          {site.principles.map((principle, index) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-border-1 py-5">
              <span aria-hidden="true" class="font-mono text-1 text-on-surface-2">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="flex flex-col gap-1">
                <h3 class="text-4">{principle.title}</h3>
                <p class="text-3 text-on-surface-2">{principle.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </SectionRow>
    )}

    {experience.length > 0 && (
      <SectionRow label={t.companies} id="companies-title">
        <CompanyList experience={experience} projects={projects} />
      </SectionRow>
    )}
  </div>
</BaseLayout>
