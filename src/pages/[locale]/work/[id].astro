---
// SPEC §5.3 (ADR 0008, L-24): one page per project, as a consultancy page. Each section is a
// SectionRow and renders only when its data exists; `depth: "card"` projects get the challenge,
// outcomes and stack. No cover, tilted band or outcome boxes.
import DecisionList from '@/components/patterns/DecisionList.astro';
import Gallery from '@/components/patterns/Gallery.astro';
import Outcomes from '@/components/patterns/Outcomes.astro';
import InlineLinkList from '@/components/ui/InlineLinkList.astro';
import SectionRow from '@/components/ui/SectionRow.astro';
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import { caseStudySections, stackLinks } from '@/lib/case-study';
import {
  getExperience,
  getProjects,
  getSkills,
  publicFileExists,
  publicImageSize,
  siteLocales,
} from '@/lib/content';
import { localePath, strings, toLocale } from '@/lib/i18n';
import { prevNext } from '@/lib/derive';
import { employerNames } from '@/lib/format';
import type { Project } from '@/lib/schemas';

export async function getStaticPaths() {
  const pages = await Promise.all(
    siteLocales().map(async (locale) =>
      (await getProjects(locale)).map((project) => ({
        params: { locale, id: project.id },
        props: { project },
      })),
    ),
  );
  return pages.flat();
}

const { project } = Astro.props as { project: Project };
const locale = toLocale(Astro.params.locale);
const ui = strings(locale);
const [projects, skills, experience] = await Promise.all([
  getProjects(locale),
  getSkills(locale),
  getExperience(locale),
]);
const { prev, next } = prevNext(projects, project.id);
const sections = caseStudySections(project, publicFileExists);
const { challenge, decisions, gallery, outcomes, takeaway } = sections;
const galleryImages = await Promise.all(
  (gallery?.images ?? []).map(async (image) => ({
    ...image,
    ...(await publicImageSize(image.src)),
  })),
);
const t = ui.caseStudy;
const skillLabels = new Map(skills.map((skill) => [skill.id, skill.label]));
const clouds = project.clouds.flatMap((id) => skillLabels.get(id) ?? []);
---

<CaseStudyLayout
  project={project}
  deliveredVia={employerNames(project, experience)}
  clouds={clouds}
  prev={prev}
  next={next}
>
  {challenge && (
    <SectionRow label={t.challenge} id="challenge">
      <p class="text-4">{challenge.body}</p>
    </SectionRow>
  )}
  {decisions && (
    <SectionRow label={t.decisions} id="decisions">
      <DecisionList items={decisions.items} />
    </SectionRow>
  )}
  {outcomes && (
    <SectionRow label={t.outcomes} id="outcomes">
      <Outcomes items={outcomes.items} />
    </SectionRow>
  )}
  <SectionRow label={t.stack} id="stack">
    <InlineLinkList items={stackLinks(project, skills, localePath(locale, '/work'))} />
  </SectionRow>
  {gallery && (
    <SectionRow label={t.gallery} id="gallery">
      <Gallery images={galleryImages} />
    </SectionRow>
  )}
  {takeaway && (
    <SectionRow label={t.takeaway} id="takeaway">
      <p class="font-heading text-6 text-balance">{takeaway.body}</p>
    </SectionRow>
  )}
</CaseStudyLayout>
