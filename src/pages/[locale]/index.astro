---
// SPEC §5.1: hero, featured work, clouds, products, certifications, contact CTA. A landing page
// (BACKLOG-LANDING L-08, ADR 0006): every section fills the screen and snaps by proximity.
import CloudPanels from '@/components/patterns/CloudPanels.astro';
import CredentialLedger from '@/components/patterns/CredentialLedger.astro';
import CoverCard from '@/components/patterns/CoverCard.astro';
import Hero from '@/components/patterns/Hero.astro';
import HeroGlobe from '@/components/patterns/HeroGlobe.astro';
import LandingSection from '@/components/patterns/LandingSection.astro';
import ProductIndex from '@/components/patterns/ProductIndex.astro';
import ProductTicker from '@/components/patterns/ProductTicker.astro';
import SectionIndicator from '@/components/patterns/SectionIndicator.astro';
import Icon from '@/components/ui/Icon.astro';
import RoundAction from '@/components/ui/RoundAction.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCertifications, getProjects, getSite, getSkills, siteLocales } from '@/lib/content';
import { localePath, strings, toLocale } from '@/lib/i18n';
import { cloudStats, skillStats, sortProjects } from '@/lib/derive';
import { pageMeta, personJsonLd } from '@/lib/seo';

export function getStaticPaths() {
  return siteLocales().map((locale) => ({ params: { locale } }));
}

const locale = toLocale(Astro.params.locale);
const ui = strings(locale);

const MAX_FEATURED = 4;

const site = getSite(locale);
const siteUrl = (Astro.site ?? new URL(import.meta.env.SITE)).href;
const [projects, skills, certifications] = await Promise.all([
  getProjects(locale),
  getSkills(locale),
  getCertifications(locale),
]);
const featured = sortProjects(projects)
  .filter((project) => project.featured)
  .slice(0, MAX_FEATURED);
const clouds = cloudStats(skills, projects, certifications);
const productSkills = skills.filter(
  (skill) => skill.group === 'products' || skill.group === 'tools',
);
const products = skillStats(productSkills, projects).map((stat, index) => ({
  id: stat.id,
  label: productSkills[index].label,
  projectCount: stat.projectCount,
}));
// The hero globe's moons (L-35): clouds with at least one project.
const workedClouds = clouds.filter((cloud) => cloud.projectCount > 0);
const t = ui.home;
const sections = [
  { id: 'intro', label: t.intro },
  featured.length > 0 && { id: 'work', label: t.featured },
  clouds.length > 0 && { id: 'clouds', label: t.clouds },
  products.length > 0 && { id: 'products', label: t.products },
  certifications.length > 0 && { id: 'certifications', label: t.certifications },
  { id: 'contact', label: ui.nav.contact },
].filter((section) => section !== false);
---

<BaseLayout
  meta={pageMeta(site, { page: 'home' }, ui.titleTemplate)}
  jsonLd={personJsonLd(site, siteUrl)}
>
  <Hero site={site}>
    <HeroGlobe slot="globe" clouds={workedClouds} />
  </Hero>

  <SectionIndicator sections={sections} />

  <div data-landing>
    {featured.length > 0 && (
      <LandingSection id="work" shape="ring" aria-labelledby="featured-title">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="featured-title">{t.featured}</h2>
          <a
            href={localePath(locale, '/work')}
            class="inline-flex items-center gap-2 text-3 font-medium"
          >
            {t.allProjects}
            <Icon name="arrow-right" />
          </a>
        </div>
        {/* Scroll-snap row below lg, 2-column grid from lg (DESIGN §10). */}
        <ul class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:-mx-6 sm:px-6 lg:mx-0 lg:grid lg:grid-cols-2 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0">
          {featured.map((project) => (
            <li class="w-[85%] shrink-0 snap-start sm:w-[60%] lg:w-auto">
              <CoverCard
                title={project.title}
                subtitle={project.subtitle}
                href={localePath(locale, `/work/${project.id}`)}
                cover={project.cover}
              />
            </li>
          ))}
        </ul>
      </LandingSection>
    )}

    {clouds.length > 0 && (
      <LandingSection id="clouds" shape="wave" aria-labelledby="clouds-title">
        <h2 id="clouds-title">{t.clouds}</h2>
        <CloudPanels clouds={clouds} />
      </LandingSection>
    )}

    {products.length > 0 && (
      <LandingSection id="products" shape="chevron" aria-labelledby="products-title">
        <h2 id="products-title">{t.products}</h2>
        <ProductTicker items={products} id="products-ticker">
          <ProductIndex items={products} />
        </ProductTicker>
      </LandingSection>
    )}

    {certifications.length > 0 && (
      <LandingSection id="certifications" shape="blob" aria-labelledby="certifications-title">
        <h2 id="certifications-title">{t.certifications}</h2>
        <CredentialLedger
          certifications={certifications}
          skills={skills}
          credentialsUrl={site.links.credentials}
        />
      </LandingSection>
    )}

    <LandingSection id="contact" aria-label={ui.nav.contact} shape="tube" bleed>
      <div class="mx-auto flex w-full max-w-180 flex-col items-start gap-6 px-4 sm:px-6 lg:px-8">
        <p class="font-heading text-6 text-balance">{site.ctaLine}</p>
        <RoundAction href={localePath(locale, '/contact')} label={t.contact} />
      </div>
    </LandingSection>
  </div>
</BaseLayout>
