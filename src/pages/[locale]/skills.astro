---
// SPEC §5.4 (ADR 0008, L-25): a capability index. Clouds with projects on one line, then each
// skill group, the certifications ledger and the languages, each a SectionRow. No bento, counts,
// tickets or second clouds group.
import CredentialLedger from '@/components/patterns/CredentialLedger.astro';
import SkillGroups from '@/components/patterns/SkillGroups.astro';
import InlineLinkList from '@/components/ui/InlineLinkList.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SectionRow from '@/components/ui/SectionRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCertifications, getProjects, getSite, getSkills, siteLocales } from '@/lib/content';
import { localePath, strings, toLocale } from '@/lib/i18n';
import { skillGroupChips } from '@/lib/derive';
import { pageMeta } from '@/lib/seo';

export function getStaticPaths() {
  return siteLocales().map((locale) => ({ params: { locale } }));
}

const locale = toLocale(Astro.params.locale);
const ui = strings(locale);

const site = getSite(locale);
const [projects, skills, certifications] = await Promise.all([
  getProjects(locale),
  getSkills(locale),
  getCertifications(locale),
]);
const groups = skillGroupChips(site.skillGroups, skills, projects, localePath(locale, '/work'));
const clouds = (groups.find((group) => group.id === 'clouds')?.skills ?? []).filter(
  (cloud) => cloud.href,
);
const otherGroups = groups.filter((group) => group.id !== 'clouds');
const t = ui.skills;
---

<BaseLayout meta={pageMeta(site, { page: 'skills' }, ui.titleTemplate)}>
  <div class="mx-auto flex w-full max-w-300 flex-col gap-12 px-4 py-16 sm:px-6 lg:gap-16 lg:px-8 lg:py-24">
    <PageHeader title={site.seo.pages.skills.title} lead={site.seo.pages.skills.description} />

    <div class="flex flex-col gap-12">
      {clouds.length > 0 && (
        <SectionRow label={t.clouds} id="clouds-title">
          <InlineLinkList
            items={clouds.map(({ label, href }) => ({ label, href }))}
            class="text-5"
          />
        </SectionRow>
      )}

      <SkillGroups groups={otherGroups} />

      {certifications.length > 0 && (
        <SectionRow label={t.certifications} id="certifications-title" stacked>
          <CredentialLedger
            certifications={certifications}
            skills={skills}
            credentialsUrl={site.links.credentials}
          />
        </SectionRow>
      )}

      {site.languages.length > 0 && (
        <SectionRow label={t.languages} id="languages-title">
          <dl class="flex flex-col gap-3">
            {site.languages.map((language) => (
              <div class="flex flex-wrap items-baseline gap-x-3">
                <dt class="text-4">{language.label}</dt>
                <dd class="text-3 text-on-surface-2">{language.level}</dd>
              </div>
            ))}
          </dl>
        </SectionRow>
      )}
    </div>
  </div>
</BaseLayout>
