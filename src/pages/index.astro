---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSite } from '@/lib/content';
import { pageMeta, personJsonLd } from '@/lib/seo';

const site = getSite();
const siteUrl = (Astro.site ?? new URL(import.meta.env.SITE)).href;
---

<BaseLayout meta={pageMeta(site, { page: 'home' })} jsonLd={personJsonLd(site, siteUrl)}>
  <div class="grid place-items-center px-4 py-32 text-center">
    <div class="flex flex-col items-center gap-3">
      <h1>{site.name}</h1>
      <p class="text-4 text-on-surface-2">{site.role}</p>
    </div>
  </div>
</BaseLayout>
