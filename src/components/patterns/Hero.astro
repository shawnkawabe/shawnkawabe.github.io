---
// SPEC §5.1 hero: name at display size, role, intro with **terms** brighter, two
// actions. Static HTML so the name is the LCP element; the gradient poster sits behind it, and the
// page passes the data-core scene (HeroScene) into the `scene` slot. The first full-viewport
// landing section (BACKLOG-LANDING L-08).
import { buttonVariants } from '@/components/ui/button';
import Icon from '@/components/ui/Icon.astro';
import SplitWords from '@/components/ui/SplitWords.astro';
import { emphasisParts } from '@/lib/format';
import { splitWords } from '@/lib/motion';
import type { Site } from '@/lib/schemas';
import { localeFromPath, localePath, strings } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const ui = strings(locale);

interface Props {
  site: Pick<Site, 'name' | 'role' | 'intro' | 'links'>;
}

const { site } = Astro.props;
const t = ui.home;
---

<section
  id="intro"
  aria-label={site.name}
  data-landing-section
  class="relative isolate flex min-h-svh snap-start flex-col justify-center overflow-hidden"
>
  <div aria-hidden="true" class="pf-hero-glow absolute inset-0 -z-10">
    <slot name="scene" />
  </div>
  <div
    data-landing-content
    class="mx-auto flex w-full max-w-300 flex-col items-start gap-6 px-4 py-20 sm:px-6 lg:px-8 lg:py-24"
  >
    <div class="flex max-w-180 flex-col gap-4">
      <h1 class="font-display text-9 font-bold tracking-display text-balance">
        <SplitWords text={site.name} />
      </h1>
      <p class="font-heading text-5 text-on-surface-1">
        <SplitWords text={site.role} offset={splitWords(site.name).length} />
      </p>
    </div>
    <p class="max-w-180 text-4 text-on-surface-2">
      {emphasisParts(site.intro).map((part) =>
        part.strong ? (
          <strong class="font-medium text-on-surface-1">{part.text}</strong>
        ) : (
          part.text
        ),
      )}
    </p>
    <div class="flex flex-wrap gap-3 pt-2">
      <a
        href={localePath(locale, '/work')}
        class:list={[buttonVariants({ variant: 'brand', size: 'lg' }), 'no-underline']}
      >
        {t.seeWork}
        <Icon name="arrow-right" />
      </a>
      <a
        href={site.links.resume}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[buttonVariants({ variant: 'neutral', size: 'lg' }), 'no-underline']}
      >
        {t.resume}
        <Icon name="external" />
        <span class="sr-only"> ({ui.nav.newTab})</span>
      </a>
    </div>
  </div>
</section>
