---
// SPEC §5.1 hero, layout A "planet horizon" (BACKLOG-LANDING L-39). A quiet meta row (name as the
// h1, location), then role, the claim with its last word in the outlined serif (ADR 0009), the
// intro with **terms** brighter, and the round "See my work" action beside a plain resume link.
// From lg the text block is centred above the cloud globe, which the page passes into the `globe`
// slot; below lg it is left-aligned and the globe crops under it. Static HTML, so the claim is the
// LCP element. The first full-viewport landing section (L-08).
import Icon from '@/components/ui/Icon.astro';
import RoundAction from '@/components/ui/RoundAction.astro';
import SplitWords from '@/components/ui/SplitWords.astro';
import { emphasisParts, lastWordParts } from '@/lib/format';
import type { Site } from '@/lib/schemas';
import { localeFromPath, localePath, strings } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const ui = strings(locale);

interface Props {
  site: Pick<Site, 'name' | 'role' | 'headline' | 'intro' | 'location' | 'links'>;
}

const { site } = Astro.props;
const t = ui.home;
const claim = lastWordParts(site.headline);
---

<section
  id="intro"
  aria-label={site.name}
  data-landing-section
  class="relative isolate flex min-h-svh snap-start flex-col overflow-hidden"
>
  <div
    data-landing-content
    class="mx-auto flex w-full max-w-300 flex-1 flex-col gap-12 px-4 pt-20 pb-10 sm:px-6 lg:gap-6 lg:px-8 lg:pt-8 lg:pb-0"
  >
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 lg:pr-16">
      <h1 class="font-heading text-6 font-semibold tracking-display max-lg:sr-only">
        <SplitWords text={site.name} />
      </h1>
      {site.location && <p class="font-mono text-1 text-on-surface-2">{site.location}</p>}
    </div>
    <div class="flex flex-col items-start gap-6 lg:my-auto lg:items-center lg:gap-5 lg:text-center">
      <p class="font-mono text-2 text-on-surface-2">{site.role}</p>
      {site.headline && (
        <p class="max-w-280 font-display text-9 leading-none font-bold tracking-display text-balance">
          {claim.lead}
          <span class="pf-outline font-serif font-normal tracking-normal">{claim.last}</span>
        </p>
      )}
      <p class="max-w-180 text-4 text-on-surface-2">
        {emphasisParts(site.intro).map((part) =>
          part.strong ? (
            <strong class="font-medium text-on-surface-1">{part.text}</strong>
          ) : (
            part.text
          ),
        )}
      </p>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4 pt-2">
        <RoundAction href={localePath(locale, '/work')} label={t.seeWork} />
        <a
          href={site.links.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-b border-border-2 pb-0.5 text-3 font-medium text-on-surface-1 no-underline transition-colors duration-150 hover:border-on-surface-1"
        >
          {t.resume}
          <Icon name="arrow-up-right" size={16} />
          <span class="sr-only"> ({ui.nav.newTab})</span>
        </a>
      </div>
    </div>
  </div>
  <slot name="globe" />
</section>
