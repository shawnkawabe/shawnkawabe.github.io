---
// SPEC §5.6: the form renders only with a Web3Forms key; an empty key leaves the direct links alone.
import ContactForm from '@/components/patterns/ContactForm';
import en from '@/i18n/en.json';
import type { Site } from '@/lib/schemas';

interface Props {
  web3formsKey: string;
  site: Pick<Site, 'contact' | 'links'>;
}

const { web3formsKey, site } = Astro.props;
---

{web3formsKey && (
  <section aria-labelledby="form-title" class="flex flex-col gap-6">
    <h2 id="form-title" class="text-6">
      {en.contact.formTitle}
    </h2>
    <ContactForm
      client:visible
      web3formsKey={web3formsKey}
      projectTypes={site.contact.projectTypes}
      successMessage={site.contact.successMessage}
      errorMessage={site.contact.errorMessage}
      fallbackEmail={site.links.email}
    />
  </section>
)}
