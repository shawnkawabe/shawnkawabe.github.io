---
// SPEC §5.4 item 2: one row of chips per skill group. "Label · N projects"; a chip links to the
// filtered Work page only when the skill has projects. No ratings of any kind.
import Chip from '@/components/ui/Chip.astro';
import en from '@/i18n/en.json';
import type { SkillChip } from '@/lib/derive';
import { plural } from '@/lib/format';

interface Props {
  groups: { id: string; label: string; skills: SkillChip[] }[];
}

const { groups } = Astro.props;
---

<div class="flex flex-col gap-10">
  {groups.map((group) => (
    <div class="flex flex-col gap-4">
      <h3 class="text-5">{group.label}</h3>
      <ul class="flex flex-wrap gap-2">
        {group.skills.map((skill) => (
          <li>
            <Chip href={skill.href} accent={skill.accent} wrap>
              {skill.label}
              {skill.count > 0 && (
                <span class="font-mono text-1 text-on-surface-2">
                  · {plural(en.cards.projects, skill.count)}
                </span>
              )}
            </Chip>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
