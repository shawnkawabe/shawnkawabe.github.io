---
// SPEC §5.4 item 2 (ADR 0008, L-25): one SectionRow per skill group, its skills as an inline list.
// A skill links to the filtered Work page only when it has projects. No counts or ratings.
import InlineLinkList from '@/components/ui/InlineLinkList.astro';
import SectionRow from '@/components/ui/SectionRow.astro';
import type { SkillChip } from '@/lib/derive';

interface Props {
  groups: { id: string; label: string; skills: SkillChip[] }[];
}

const { groups } = Astro.props;
---

{groups.map((group) => (
  <SectionRow label={group.label} id={`skills-${group.id}`}>
    <InlineLinkList items={group.skills.map(({ label, href }) => ({ label, href }))} />
  </SectionRow>
))}
