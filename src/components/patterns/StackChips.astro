---
// SPEC §5.3 item 8: every cloud and capability as a chip linking to Work filtered by it.
import Chip from '@/components/ui/Chip.astro';
import type { StackLink } from '@/lib/case-study';

interface Props {
  links: StackLink[];
}

const { links } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {links.map((link) => (
    <li>
      <Chip href={link.href} accent={link.accent}>
        {link.label}
      </Chip>
    </li>
  ))}
</ul>
