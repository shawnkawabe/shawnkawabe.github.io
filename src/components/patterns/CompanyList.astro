---
// SPEC §5.5 item 3 (ADR 0008, L-26): an experience ledger. Each company with Shawn's role there and
// its projects as an inline link list, on hairline rows. No dates and no timeline (CLAUDE.md rule
// 3a); project ids not in projects.json are skipped.
import InlineLinkList from '@/components/ui/InlineLinkList.astro';
import type { Experience, Project } from '@/lib/schemas';
import { localeFromPath, localePath } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);

interface Props {
  experience: readonly Pick<Experience, 'id' | 'employer' | 'role' | 'projectIds'>[];
  projects: readonly Pick<Project, 'id' | 'title'>[];
}

const { experience, projects } = Astro.props;
const byId = new Map(projects.map((project) => [project.id, project]));
---

<ul class="border-t border-border-1">
  {experience.map((entry) => {
    const linked = entry.projectIds.flatMap((id) => byId.get(id) ?? []);
    return (
      <li class="flex flex-col gap-3 border-b border-border-1 py-6">
        <div class="flex flex-col gap-1">
          <h3 class="text-5">{entry.employer}</h3>
          <p class="text-3 text-on-surface-2">{entry.role}</p>
        </div>
        <InlineLinkList
          items={linked.map((project) => ({
            label: project.title,
            href: localePath(locale, `/work/${project.id}`),
          }))}
          class="text-2"
        />
      </li>
    );
  })}
</ul>
