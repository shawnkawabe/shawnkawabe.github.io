---
// Certifications as credential tickets (BACKLOG-LANDING L-07): text only, no logos, no dates. A body
// with the issuer, the credential and the skills it covers, and a perforated stub with a mono serial.
// The whole ticket links to the credentials page when site.links.credentials is set.
import Icon from '@/components/ui/Icon.astro';
import { credentialSkills } from '@/lib/derive';
import { credentialParts } from '@/lib/format';
import { localeFromPath, strings } from '@/lib/i18n';
import type { Certification, Skill } from '@/lib/schemas';

const ui = strings(localeFromPath(Astro.url.pathname));

interface Props {
  certifications: readonly Certification[];
  skills: readonly Skill[];
  credentialsUrl: string;
  level?: 3 | 4;
}

const MAX_SKILLS = 3;

const { certifications, skills, credentialsUrl, level = 3 } = Astro.props;
const Title = `h${level}` as const;
const Tag = credentialsUrl ? 'a' : 'div';
const link = credentialsUrl
  ? { href: credentialsUrl, target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
  {certifications.map((certification, index) => {
    const { issuer, title } = credentialParts(certification.label);
    const covers = credentialSkills(certification, skills).slice(0, MAX_SKILLS);
    const accent = covers.find((skill) => skill.accent)?.accent;
    const serial = String(index + 1).padStart(2, '0');
    return (
      <li>
        <Tag
          {...link}
          style={accent && `--pf-c-cloud-accent: var(--pf-g-color-${accent})`}
          class="pf-ticket group relative flex h-full rounded-lg border border-border-1 bg-surface-2 text-on-surface-1 no-underline transition-[translate,border-color,box-shadow] duration-250 ease-standard hover:-translate-y-1 hover:border-border-2 hover:shadow-cloud-glow"
        >
          <span
            aria-hidden="true"
            class="absolute inset-y-4 left-0 w-0.5 rounded-pill bg-(--pf-c-cloud-accent,var(--pf-g-color-accent-1)) opacity-50 transition-opacity duration-250 group-hover:opacity-100"
          />
          <div class="flex min-w-0 flex-1 flex-col gap-3 p-6">
            {issuer && (
              <p class="font-mono text-1 tracking-label text-on-surface-2 uppercase">{issuer}</p>
            )}
            <Title class="font-heading text-5 text-balance">
              {issuer && <span class="sr-only">{issuer} </span>}
              {title}
            </Title>
            {covers.length > 0 && (
              <ul class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-2 text-2 text-on-surface-2">
                {covers.map((skill) => (
                  <li class="flex items-center gap-2">
                    <span
                      aria-hidden="true"
                      class:list={[
                        'size-1.5 rounded-pill',
                        skill.accent ? 'bg-(--pf-c-skill-accent)' : 'bg-on-surface-2',
                      ]}
                      style={
                        skill.accent && `--pf-c-skill-accent: var(--pf-g-color-${skill.accent})`
                      }
                    />
                    {skill.label}
                  </li>
                ))}
              </ul>
            )}
          </div>
          <div class="pf-ticket-stub flex w-16 shrink-0 flex-col items-center justify-between border-l border-dashed border-border-2 py-6 text-on-surface-2">
            <span
              aria-hidden="true"
              class="font-mono text-1 tracking-label [writing-mode:vertical-rl]"
            >
              CERT·{serial}
            </span>
            {credentialsUrl ? (
              <>
                <Icon
                  name="arrow-up-right"
                  class="transition-colors group-hover:text-on-surface-1"
                />
                <span class="sr-only"> ({ui.nav.newTab})</span>
              </>
            ) : (
              <Icon name="check" />
            )}
          </div>
        </Tag>
      </li>
    );
  })}
</ul>
