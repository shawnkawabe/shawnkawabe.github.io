---
// SPEC §6.3 bento: the 3D constellation's fallback and the Skills clouds grid. `clouds` comes
// from cloudStats(), which already leaves out clouds with no projects and no certifications.
import { withBentoSize, type BentoSize, type CloudStat } from '@/lib/derive';
import CloudCard from './CloudCard.astro';

interface Props {
  clouds: CloudStat[];
  level?: 2 | 3;
}

const span: Record<BentoSize, string | undefined> = {
  feature: 'col-span-2 row-span-2',
  wide: 'col-span-2 lg:col-span-1',
  base: undefined,
};

const { clouds, level } = Astro.props;
---

<ul class="grid grid-flow-dense grid-cols-2 gap-4 lg:grid-cols-3">
  {withBentoSize(clouds).map(({ size, ...cloud }) => (
    <li class={span[size]} data-size={size}>
      <CloudCard cloud={cloud} size={size} level={level} />
    </li>
  ))}
</ul>
