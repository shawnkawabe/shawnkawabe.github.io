---
// Home "Clouds I work in" (BACKLOG-LANDING L-05): expanding panels. From lg, a row of tall panels
// where the open one widens; below lg, a stacked accordion. Each heading holds a disclosure button
// (APG accordion). Without JavaScript every panel shows its details, so nothing depends on it.
// The open panel names the cloud and its project count only (L-18); the projects are on Work.
import Icon from '@/components/ui/Icon.astro';
import type { CloudStat } from '@/lib/derive';
import { plural } from '@/lib/format';
import type { CloudIconName } from '@/lib/icons';
import { localeFromPath, localePath, strings } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const ui = strings(locale);

interface Props {
  clouds: CloudStat[];
}

const { clouds } = Astro.props;
const t = ui.cloudPanels;
const workPath = localePath(locale, '/work');
---

<ul data-cloud-panels class="flex flex-col gap-3 lg:h-[min(36rem,70svh)] lg:flex-row">
  {clouds.map((cloud, index) => {
    const id = `cloud-panel-${cloud.id}`;
    const stats = plural(ui.cards.projects, cloud.projectCount);
    return (
      <li
        data-cloud-panel
        data-open={index === 0 ? '' : undefined}
        style={cloud.accent && `--pf-c-cloud-accent: var(--pf-g-color-${cloud.accent})`}
        class="pf-cloud-panel group relative isolate flex min-w-0 flex-col overflow-hidden rounded-lg border border-border-1 bg-surface-2 transition-[flex-grow,border-color] duration-450 ease-emphasised data-open:border-border-2 lg:flex-1 lg:data-open:grow-[5]"
      >
        <span
          aria-hidden="true"
          class="absolute inset-x-0 top-0 h-0.5 bg-(--pf-c-cloud-accent) opacity-40 transition-opacity duration-250 group-data-open:opacity-100"
        />
        <h3 class="text-5">
          <button
            type="button"
            data-cloud-toggle
            aria-expanded={index === 0 ? 'true' : 'false'}
            aria-controls={id}
            class="flex w-full cursor-pointer items-center gap-4 p-5 text-left lg:h-full lg:flex-col lg:items-start lg:group-data-open:h-auto"
          >
            <span class="text-(--pf-c-cloud-accent)">
              <Icon name={cloud.id as CloudIconName} size={32} />
            </span>
            {/* One constant name for assistive tech; the two visual labels swap with the state. */}
            <span class="sr-only">{cloud.label}</span>
            <span
              aria-hidden="true"
              class="min-w-0 flex-1 font-heading lg:flex-none lg:[writing-mode:vertical-rl] lg:group-data-open:hidden"
            >
              {cloud.label}
            </span>
            <span class="font-mono text-1 tracking-label text-on-surface-2 uppercase lg:mt-auto lg:group-data-open:hidden">
              <span aria-hidden="true">{String(cloud.projectCount).padStart(2, '0')}</span>
              <span class="sr-only">{stats}</span>
            </span>
            <span
              aria-hidden="true"
              class="hidden font-display text-7 tracking-display text-balance lg:group-data-open:block"
            >
              {cloud.label}
            </span>
            <Icon
              name="chevron-down"
              class="text-on-surface-2 transition-transform duration-250 group-data-open:rotate-180 lg:hidden"
            />
          </button>
        </h3>
        <div
          id={id}
          data-cloud-detail
          class="flex flex-col gap-5 px-5 pb-5 lg:w-[min(34rem,100%)] lg:flex-1"
        >
          <p class="font-mono text-1 tracking-label text-on-surface-2 uppercase">{stats}</p>
          <a
            href={`${workPath}?cloud=${cloud.id}`}
            class="mt-auto inline-flex items-center gap-2 self-start text-3 font-medium"
          >
            {t.seeProjects}
            <span class="sr-only">: {cloud.label}</span>
            <Icon name="arrow-right" />
          </a>
        </div>
      </li>
    );
  })}
</ul>

<script>
  import { bindCloudPanels } from '@/lib/cloud-panels';

  bindCloudPanels();
</script>
