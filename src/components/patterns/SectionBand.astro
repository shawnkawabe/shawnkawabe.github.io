---
// DESIGN §9 SectionBand: full-bleed tinted band. Only the background tilts (−2°…2°, ≥ lg),
// so the text never rotates and needs no counter-rotation. Clipped sideways: the tilted corners
// would otherwise widen the page by a few pixels. An untilted band also reaches under the nav
// rail's gutter (`lg:pl-30` in BaseLayout), so it spans the whole viewport (L-33).
interface Props {
  tone: 'a' | 'b';
  /** Degrees, clamped to −2…2. */
  tilt?: number;
  class?: string;
}

const MAX_TILT = 2;

const { tone, tilt = 0, class: className } = Astro.props;
const degrees = Math.max(-MAX_TILT, Math.min(MAX_TILT, tilt));
---

<div
  class:list={['relative isolate py-16 lg:py-20', degrees !== 0 && 'overflow-x-clip', className]}
>
  <div
    aria-hidden="true"
    style={degrees !== 0 ? `--pf-c-band-tilt: ${degrees}deg` : undefined}
    class:list={[
      'absolute inset-0 -z-10',
      degrees !== 0 ? 'lg:rotate-(--pf-c-band-tilt)' : 'lg:-left-30',
      tone === 'a' ? 'bg-band-a' : 'bg-band-b',
    ]}
  ></div>
  <slot />
</div>
