---
// SPEC §5.3 item 9: neighbours in sort order (prevNext()); no wrap-around, so an end has one link.
// Plain links on a hairline (ADR 0008, L-24); the title turns `accent-1` on hover.
import Icon from '@/components/ui/Icon.astro';
import type { Project } from '@/lib/schemas';
import { localeFromPath, localePath, strings } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const ui = strings(locale);

type Neighbour = Pick<Project, 'id' | 'title'> | undefined;

interface Props {
  prev: Neighbour;
  next: Neighbour;
}

const { prev, next } = Astro.props;
const t = ui.caseStudy;
const link = 'group flex flex-col gap-1 py-6 no-underline';
const title =
  'text-5 font-semibold text-on-surface-1 transition-colors duration-150 group-hover:text-accent-1';
---

{(prev || next) && (
  <nav aria-label={t.pagerLabel} class="grid gap-4 border-t border-border-1 sm:grid-cols-2">
    {prev && (
      <a href={localePath(locale, `/work/${prev.id}`)} rel="prev" class={link}>
        <span class="flex items-center gap-2 text-2 text-on-surface-2">
          <Icon name="arrow-left" size={16} />
          {t.previous}
        </span>
        <span class={title}>{prev.title}</span>
      </a>
    )}
    {next && (
      <a
        href={localePath(locale, `/work/${next.id}`)}
        rel="next"
        class:list={[link, 'sm:col-start-2 sm:text-right']}
      >
        <span class="flex items-center gap-2 text-2 text-on-surface-2 sm:justify-end">
          {t.next}
          <Icon name="arrow-right" size={16} />
        </span>
        <span class={title}>{next.title}</span>
      </a>
    )}
  </nav>
)}
