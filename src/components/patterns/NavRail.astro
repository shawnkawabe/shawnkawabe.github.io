---
// Desktop nav rail (SPEC §4.1, DESIGN §9): floating pill, icon links with CSS-only tooltips.
// Collapsible to a single handle (BACKLOG-LANDING L-02); global.css hides the body on <html data-rail>.
// Collapsed, the handle is a circle showing where the reader is (L-09): the page's icon, or on Home
// the current section's number, which src/lib/rail.ts keeps in sync with the section indicator.
import Icon from '@/components/ui/Icon.astro';
import { getSite } from '@/lib/content';
import { externalLinks, isActive, pageLinks } from '@/lib/nav';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { localeFromPath, strings } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const ui = strings(locale);

const pathname = Astro.url.pathname;
const groups = [pageLinks(locale), externalLinks(getSite(locale), locale)];
const current = groups[0].find((link) => isActive(pathname, link.href));
const onHome = current?.icon === 'home';
const currentName = onHome ? ui.home.intro : current?.label;

const item =
  'group relative flex size-10 items-center justify-center rounded-pill text-on-surface-2 no-underline transition-colors duration-150 ease-standard hover:bg-surface-3 hover:text-on-surface-1';
const tooltip =
  'pointer-events-none absolute top-1/2 left-full ml-4 -translate-y-1/2 rounded-sm bg-surface-3 px-3 py-1 text-2 whitespace-nowrap text-on-surface-1 opacity-0 shadow-2 transition-opacity duration-150 ease-standard group-hover:opacity-100 group-focus-visible:opacity-100';
---

<nav
  aria-label={ui.nav.label}
  data-rail-nav
  class="fixed top-16 left-6 z-40 hidden w-16 flex-col items-center gap-2 rounded-pill bg-surface-2/90 p-2 shadow-1 backdrop-blur-md lg:flex"
>
  <button
    type="button"
    data-rail-toggle
    data-label-collapse={ui.nav.collapse}
    data-label-expand={ui.nav.expand}
    data-label-expand-current={ui.nav.expandCurrent}
    data-current={currentName}
    aria-controls="rail-body"
    aria-expanded="true"
    aria-label={ui.nav.collapse}
    class:list={[item, 'cursor-pointer']}
  >
    <span data-rail-icon="collapse">
      <Icon name="rail-collapse" />
    </span>
    <span data-rail-icon="expand">
      {onHome ? (
        <span data-rail-section class="font-mono text-2 tracking-label text-on-surface-1">
          01
        </span>
      ) : (
        <Icon name={current?.icon ?? 'rail-expand'} />
      )}
    </span>
  </button>
  <div id="rail-body" data-rail-body class="flex flex-col items-center gap-2">
    <span class="my-1 h-px w-6 bg-border-1" aria-hidden="true"></span>
    {groups.map((links, index) => (
      <>
        {index > 0 && <span class="my-1 h-px w-6 bg-border-1" aria-hidden="true" />}
        <ul class="flex flex-col items-center gap-2">
          {links.map(({ href, label, icon, external }) => {
            const current = !external && isActive(pathname, href);
            return (
              <li>
                <a
                  href={href}
                  class:list={[item, current && 'bg-surface-3 text-on-surface-1']}
                  aria-current={current ? 'page' : undefined}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <Icon name={icon} />
                  <span class={tooltip}>
                    {label}
                    {external && <span class="sr-only"> ({ui.nav.newTab})</span>}
                  </span>
                  {current && (
                    <span
                      class="absolute bottom-0.5 size-1 rounded-pill bg-on-surface-1"
                      aria-hidden="true"
                    />
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </>
    ))}
    <span class="my-1 h-px w-6 bg-border-1" aria-hidden="true"></span>
    <LanguageSwitcher variant="rail" />
    <ThemeToggle class="hover:bg-surface-3" />
  </div>
</nav>

<script>
  import { bindRailToggles } from '@/lib/rail';

  bindRailToggles();
</script>
