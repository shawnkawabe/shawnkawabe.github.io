---
// SPEC §5.3 item 5 "Outcome" (ADR 0008, L-24): a plain list on hairline rows. Every label renders;
// a value only when it was measured (CLAUDE.md rule 3), set large before its label.
import { outcomeValue } from '@/lib/case-study';
import type { ProjectSection } from '@/lib/schemas';

interface Props {
  items: Extract<ProjectSection, { type: 'outcomes' }>['items'];
}

const { items } = Astro.props;
---

<ul class="border-t border-border-1">
  {items.map((item) => {
    const value = outcomeValue(item);
    return (
      <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-border-1 py-4">
        {value && <span class="font-heading text-6 font-semibold">{value}</span>}
        <span class="text-3">{item.label}</span>
      </li>
    );
  })}
</ul>
