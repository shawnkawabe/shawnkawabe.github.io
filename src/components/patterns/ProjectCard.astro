---
// DESIGN §9 ProjectCard: cover, title, 3-line summary, cloud chips, client and category. No dates.
import Chip from '@/components/ui/Chip.astro';
import Cover from '@/components/ui/Cover.astro';
import type { Project } from '@/lib/schemas';
import { format } from '@/lib/seo';
import { localeFromPath, localePath, strings } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const ui = strings(locale);

interface Props {
  project: Project;
  cloudLabels: Record<string, string>;
  level?: 2 | 3;
}

const MAX_CHIPS = 3;

const { project, cloudLabels, level = 3 } = Astro.props;
const Title = `h${level}` as const;
const shown = project.clouds.slice(0, MAX_CHIPS);
const more = project.clouds.length - shown.length;
---

<a
  href={localePath(locale, `/work/${project.id}`)}
  class="group flex h-full flex-col overflow-hidden rounded-md border border-border-1 bg-surface-2 no-underline shadow-1 transition-[border-color] duration-250 ease-standard hover:border-border-2"
>
  <Cover preset={project.cover.preset} image={project.cover.image}>
    <span
      aria-hidden="true"
      class="flex size-full items-center justify-center p-6 text-center font-heading text-6 font-bold text-balance"
    >
      {project.client}
    </span>
  </Cover>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <Title class="text-5">{project.title}</Title>
    <p class="line-clamp-3 text-2 text-on-surface-2">{project.summary}</p>
    {shown.length > 0 && (
      <ul class="flex flex-wrap gap-2">
        {shown.map((id) => (
          <li>
            <Chip mono>{cloudLabels[id] ?? id}</Chip>
          </li>
        ))}
        {more > 0 && (
          <li>
            <Chip mono>
              <span aria-hidden="true">{format(ui.cards.moreClouds, { count: more })}</span>
              <span class="sr-only">{format(ui.cards.moreCloudsLabel, { count: more })}</span>
            </Chip>
          </li>
        )}
      </ul>
    )}
    <div class="mt-auto flex items-baseline justify-between gap-4 border-t border-border-1 pt-3 text-2 text-on-surface-2">
      <span class="font-mono text-1">{project.client}</span>
      <span class="text-right">{project.category}</span>
    </div>
  </div>
</a>
