---
// SPEC §5.1 hero background: the "data core" scene, behind the right half of the hero on desktop.
// A plain script gates it (≥ 1024px, motion allowed, WebGL2) and starts it only after load and idle,
// so the hero text stays the LCP element and other visitors download no React or three.js for it;
// they keep the gradient poster behind this empty host.
---

<div data-hero-scene class="absolute inset-0"></div>

<script>
  import { canRunScene, DESKTOP_QUERY, hasWebGL2 } from '@/lib/webgl';
  import { afterLoadIdle } from '@/lib/idle';
  import { REDUCED_MOTION_QUERY } from '@/lib/motion';

  for (const host of document.querySelectorAll<HTMLElement>('[data-hero-scene]')) {
    const allowed = canRunScene({
      desktop: window.matchMedia(DESKTOP_QUERY).matches,
      reducedMotion: window.matchMedia(REDUCED_MOTION_QUERY).matches,
      webgl2: hasWebGL2(),
    });
    if (!allowed) continue;
    afterLoadIdle(async () => {
      const { mountDataCore } = await import('@/components/three/mountDataCore');
      mountDataCore(host);
    });
  }
</script>
