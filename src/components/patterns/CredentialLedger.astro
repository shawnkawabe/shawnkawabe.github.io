---
// Certifications as a ledger grouped by domain (BACKLOG-LANDING L-17, ADR 0008): text only, no
// logos, dates, tickets or serials. When every credential shares an issuer ("Salesforce
// Certified") it is named once above the groups and dropped from each row. Rows link to the
// credentials page only when site.links.credentials is set; otherwise they are plain text.
import Icon from '@/components/ui/Icon.astro';
import { credentialSkills } from '@/lib/derive';
import { credentialParts } from '@/lib/format';
import { localeFromPath, strings } from '@/lib/i18n';
import type { Certification, Skill } from '@/lib/schemas';

const ui = strings(localeFromPath(Astro.url.pathname));

interface Props {
  certifications: readonly Certification[];
  skills: readonly Skill[];
  credentialsUrl: string;
  level?: 3 | 4;
}

const MAX_SKILLS = 3;
const DOMAINS = ['development', 'data-ai', 'admin'] as const;

const { certifications, skills, credentialsUrl, level = 3 } = Astro.props;
const Title = `h${level}` as const;
const Row = credentialsUrl ? 'a' : 'div';
const link = credentialsUrl
  ? { href: credentialsUrl, target: '_blank', rel: 'noopener noreferrer' }
  : {};

const issuers = new Set(certifications.map((c) => credentialParts(c.label).issuer));
const sharedIssuer = issuers.size === 1 ? [...issuers][0] : '';
const groups = DOMAINS.map((domain) => ({
  domain,
  entries: certifications.filter((c) => c.domain === domain),
})).filter((group) => group.entries.length > 0);
---

<div class="flex flex-col gap-4">
  {sharedIssuer && <p class="text-2 text-on-surface-2">{sharedIssuer}</p>}
  <div class="border-t border-border-1">
    {groups.map(({ domain, entries }) => (
      <div class="grid gap-2 border-b border-border-1 py-6 lg:grid-cols-[11rem_1fr] lg:gap-8">
        <Title class="pt-1 font-body text-2 font-medium text-on-surface-2">
          {ui.credentials.domains[domain]}
        </Title>
        <ul class="flex flex-col">
          {entries.map((certification) => {
            const title = sharedIssuer
              ? credentialParts(certification.label).title
              : certification.label;
            const covers = credentialSkills(certification, skills)
              .slice(0, MAX_SKILLS)
              .map((skill) => skill.label);
            return (
              <li>
                <Row
                  {...link}
                  class:list={[
                    'group flex flex-col gap-1 py-2 text-on-surface-1 no-underline sm:flex-row sm:items-baseline sm:justify-between sm:gap-6',
                    credentialsUrl && 'transition-colors duration-150 hover:text-accent-1',
                  ]}
                >
                  <span class="font-heading text-5">
                    {sharedIssuer && <span class="sr-only">{sharedIssuer} </span>}
                    {title}
                  </span>
                  <span class="flex items-center gap-3 text-2 text-on-surface-2">
                    {covers.join(' · ')}
                    {credentialsUrl && (
                      <>
                        <Icon
                          name="arrow-up-right"
                          size={16}
                          class="transition-colors duration-150 group-hover:text-accent-1"
                        />
                        <span class="sr-only"> ({ui.nav.newTab})</span>
                      </>
                    )}
                  </span>
                </Row>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</div>
