---
// SPEC §5.1 item 4 / DESIGN §7: products and tools scrolling at 40s per loop. Pauses on hover and
// with the button (WCAG 2.2.2); with reduced motion it is a static wrapped list.
import Chip from '@/components/ui/Chip.astro';
import { localeFromPath, strings } from '@/lib/i18n';

const ui = strings(localeFromPath(Astro.url.pathname));

interface Props {
  items: string[];
  id: string;
}

const { items, id } = Astro.props;
---

<div class="flex flex-col items-start gap-3">
  <div
    id={id}
    class="group w-full overflow-hidden mask-x-from-90% mask-x-to-100% motion-reduce:mask-none"
  >
    <div class="flex w-max animate-marquee group-hover:[animation-play-state:paused] group-data-paused:[animation-play-state:paused] motion-reduce:w-auto motion-reduce:animate-none">
      <ul class="flex shrink-0 gap-3 pr-3 motion-reduce:flex-wrap">
        {items.map((item) => (
          <li>
            <Chip>{item}</Chip>
          </li>
        ))}
      </ul>
      {/* The copy makes the −50% loop seamless; screen readers hear the list once. */}
      <ul aria-hidden="true" class="flex shrink-0 gap-3 pr-3 motion-reduce:hidden">
        {items.map((item) => (
          <li>
            <Chip>{item}</Chip>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <button
    type="button"
    data-js-only
    data-marquee-toggle
    aria-controls={id}
    aria-pressed="false"
    class="rounded-pill px-3 py-1 font-mono text-1 tracking-label text-on-surface-2 uppercase transition-colors duration-150 ease-standard hover:text-on-surface-1 aria-pressed:text-on-surface-1 motion-reduce:hidden"
  >
    {ui.home.pauseMarquee}
  </button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-marquee-toggle]')) {
    button.addEventListener('click', () => {
      const paused = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(paused));
      document
        .getElementById(button.getAttribute('aria-controls')!)
        ?.toggleAttribute('data-paused', paused);
    });
  }
</script>
