---
// DESIGN §9 CloudCard / SPEC §6.3: icon, name and project count (L-18: no certifications or project
// names). The whole card links to Work filtered by the cloud.
import Icon from '@/components/ui/Icon.astro';
import type { BentoSize, CloudStat } from '@/lib/derive';
import { plural } from '@/lib/format';
import type { CloudIconName } from '@/lib/icons';
import { localeFromPath, localePath, strings } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const ui = strings(locale);

interface Props {
  cloud: CloudStat;
  size?: BentoSize;
  level?: 2 | 3;
}

const { cloud, size = 'base', level = 3 } = Astro.props;
const Title = `h${level}` as const;
// Display style (tighter tracking) only where the name is at least 32px (CLAUDE.md rule 6): the 2×2 card.
const display = size === 'feature';
---

<a
  href={`${localePath(locale, '/work')}?cloud=${cloud.id}`}
  style={cloud.accent && `--pf-c-cloud-accent: var(--pf-g-color-${cloud.accent})`}
  class="group flex h-full flex-col gap-4 rounded-lg border border-border-1 bg-surface-2 p-6 no-underline transition-[border-color] duration-250 ease-standard hover:border-border-2"
>
  <span class="text-(--pf-c-cloud-accent)">
    <Icon name={cloud.id as CloudIconName} size={32} />
  </span>
  <Title class:list={[display ? 'font-display text-7 tracking-display' : 'text-5']}>
    {cloud.label}
  </Title>
  <p class="font-mono text-1 text-on-surface-2">{plural(ui.cards.projects, cloud.projectCount)}</p>
</a>
