---
// DESIGN §9 CloudCard / SPEC §6.3: icon, name, project count, certifications, top projects.
// The whole card links to Work filtered by the cloud, so chips inside are plain text.
import Chip from '@/components/ui/Chip.astro';
import Icon from '@/components/ui/Icon.astro';
import type { BentoSize, CloudStat } from '@/lib/derive';
import { plural } from '@/lib/format';
import type { CloudIconName } from '@/lib/icons';
import { localeFromPath, localePath, strings } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const ui = strings(locale);

interface Props {
  cloud: CloudStat;
  size?: BentoSize;
  level?: 2 | 3;
}

const TOP_PROJECTS = 3;

const { cloud, size = 'base', level = 3 } = Astro.props;
const Title = `h${level}` as const;
// Display style (tighter tracking) only where the name is at least 32px (CLAUDE.md rule 6): the 2×2 card.
const display = size === 'feature';
const stats = [plural(ui.cards.projects, cloud.projectCount)];
if (cloud.certifications.length > 0) {
  stats.push(plural(ui.cards.certifications, cloud.certifications.length));
}
---

<a
  href={`${localePath(locale, '/work')}?cloud=${cloud.id}`}
  style={cloud.accent && `--pf-c-cloud-accent: var(--pf-g-color-${cloud.accent})`}
  data-tilt
  class="group flex h-full flex-col gap-4 rounded-lg border border-border-1 bg-surface-2 p-6 no-underline transition-[translate,border-color,box-shadow,transform] duration-250 ease-standard hover:-translate-y-0.5 hover:border-border-2 hover:shadow-cloud-glow focus-visible:shadow-cloud-glow"
>
  <span class="text-(--pf-c-cloud-accent)">
    <Icon name={cloud.id as CloudIconName} size={32} />
  </span>
  <Title class:list={[display ? 'font-display text-7 tracking-display' : 'text-5']}>
    {cloud.label}
  </Title>
  <p class="font-mono text-1 tracking-label text-on-surface-2 uppercase">{stats.join(' · ')}</p>
  {cloud.projects.length > 0 && (
    <ul class="mt-auto flex flex-wrap gap-2">
      {cloud.projects.slice(0, TOP_PROJECTS).map((project) => (
        <li class="max-w-full min-w-0">
          {/* Long titles truncate on narrow 1×1 cards; the full list is on the filtered Work page. */}
          <Chip accent={cloud.accent} class="max-w-full">
            <span class="truncate">{project.title}</span>
          </Chip>
        </li>
      ))}
    </ul>
  )}
</a>

<script>
  import { bindTilt } from '@/lib/tilt';

  bindTilt();
</script>
