---
// Round primary action (BACKLOG-LANDING L-37, docs/reference/sculpted-gradients.md): an accent
// circle with an arrow and a visible label beside it, all one link, so the label is its accessible
// name. 72px below lg, 112px from lg. On hover the arrow nudges toward its target, except under
// reduced motion. Only the page's main action uses it; others stay text links.
import Icon from '@/components/ui/Icon.astro';
import { localeFromPath, strings } from '@/lib/i18n';

interface Props {
  href: string;
  label: string;
  /** Opens in a new tab, with an up-right arrow and a "new tab" note for screen readers. */
  external?: boolean;
  class?: string;
}

const ui = strings(localeFromPath(Astro.url.pathname));
const { href, label, external = false, class: className } = Astro.props;
---

<a
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  class:list={[
    'group inline-flex items-center gap-5 rounded-pill text-on-surface-1 no-underline',
    className,
  ]}
>
  <span
    aria-hidden="true"
    class="grid size-18 shrink-0 place-items-center rounded-pill bg-accent-1 text-on-accent transition-colors duration-150 group-hover:bg-accent-1-strong lg:size-28"
  >
    <Icon
      name={external ? 'arrow-up-right' : 'arrow-right'}
      size={32}
      class:list={[
        'transition-transform duration-150 ease-standard',
        external
          ? 'motion-safe:group-hover:translate-x-1 motion-safe:group-hover:-translate-y-1'
          : 'motion-safe:group-hover:translate-x-1',
      ]}
    />
  </span>
  <span class="text-3 font-medium underline-offset-4 group-hover:underline">
    {label}
    {external && <span class="sr-only"> ({ui.nav.newTab})</span>}
  </span>
</a>
