---
// DESIGN §9 InlineLinkList (ADR 0008): items in a wrapping line split by a grey middot; items with
// a destination are links, the rest plain text. The middots are decorative.
interface Props {
  items: { label: string; href?: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

{items.length > 0 && (
  <ul class:list={['flex flex-wrap items-baseline gap-y-2 text-3', className]}>
    {items.map((item, index) => (
      <li class="flex items-baseline">
        {index > 0 && (
          <span aria-hidden="true" class="px-3 text-on-surface-3">
            ·
          </span>
        )}
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span class="text-on-surface-1">{item.label}</span>
        )}
      </li>
    ))}
  </ul>
)}
