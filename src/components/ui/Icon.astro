---
// Line icon at 1.5px stroke, rendered to static SVG (DESIGN §8): Lucide for UI, SVG files for
// clouds (original artwork) and brands. Decorative unless labelled.
import { icons, isSvgIcon, svgIcons, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  size?: 16 | 20 | 24 | 32;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': true } as const);
const classes = ['shrink-0', className].filter(Boolean).join(' ');
const Svg = isSvgIcon(name) ? svgIcons[name] : undefined;
const Lucide = isSvgIcon(name) ? undefined : icons[name];
---

{Svg && <Svg width={size} height={size} class={classes} {...a11y} />}
{Lucide && <Lucide size={size} strokeWidth={1.5} className={classes} {...a11y} />}
