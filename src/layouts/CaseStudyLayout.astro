---
// SPEC §5.3 frame: title, cover, snapshot bar, the sections (slot) and prev/next links.
import PrevNext from '@/components/patterns/PrevNext.astro';
import SnapshotBar from '@/components/patterns/SnapshotBar.astro';
import Cover from '@/components/ui/Cover.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSite } from '@/lib/content';
import type { Image, Project, Skill } from '@/lib/schemas';
import { creativeWorkJsonLd, pageMeta } from '@/lib/seo';
import { localeFromPath, strings } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);

type Neighbour = Pick<Project, 'id' | 'title'> | undefined;

interface Props {
  project: Project;
  /** Already checked with visibleImage(); otherwise the gradient preset shows. */
  coverImage: Image | undefined;
  deliveredVia: string;
  skills: readonly Skill[];
  prev: Neighbour;
  next: Neighbour;
}

const { project, coverImage, deliveredVia, skills, prev, next } = Astro.props;
const site = getSite(locale);
const url = new URL(Astro.url.pathname, Astro.site ?? import.meta.env.SITE).href;
---

<BaseLayout
  meta={pageMeta(site, { project }, strings(locale).titleTemplate)}
  jsonLd={creativeWorkJsonLd(site, project, url)}
>
  <article class="flex flex-col gap-16 overflow-x-clip py-16 lg:gap-20 lg:py-24">
    <header class="mx-auto flex w-full max-w-300 flex-col gap-10 px-4 sm:px-6 lg:px-8">
      <div class="flex max-w-180 flex-col gap-4">
        <h1>{project.title}</h1>
        <p class="text-4 text-on-surface-2">{project.subtitle}</p>
      </div>
      <Cover preset={project.cover.preset} image={coverImage} class="rounded-lg shadow-1">
        <span
          aria-hidden="true"
          class="flex size-full items-center justify-center p-6 text-center font-heading text-7 font-bold text-balance"
        >
          {project.client}
        </span>
      </Cover>
      <SnapshotBar project={project} deliveredVia={deliveredVia} skills={skills} />
    </header>
    <slot />
    <footer class="mx-auto w-full max-w-300 px-4 sm:px-6 lg:px-8">
      <PrevNext prev={prev} next={next} />
    </footer>
  </article>
</BaseLayout>
